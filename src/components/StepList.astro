---
import RichText from './RichText.astro';

interface Props {
  items: readonly string[];
  ordered?: boolean;
  className?: string;
}

const {
  items,
  ordered = false,
  className = '',
} = Astro.props;

const Tag = ordered ? 'ol' : 'ul';
---

<Tag
  class:list={[
    'list-outside space-y-2 pl-6 text-gray-700',
    ordered ? 'list-decimal' : 'list-disc',
    className,
  ]}
>
  {items.map((item) => <li><RichText text={item} /></li>)}
</Tag>
