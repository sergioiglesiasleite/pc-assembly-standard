---
import { AlertTriangle, Lightbulb } from 'lucide-react';

interface Props {
  variant?: 'warning' | 'info' | 'tip';
  className?: string;
}

const { variant = 'info', className = '' } = Astro.props;

const styles = {
  warning: {
    container: 'border-red-400 bg-red-50 text-red-900',
    icon: 'text-red-600',
    Icon: AlertTriangle,
  },
  info: {
    container: 'border-blue-400 bg-blue-50 text-gray-800',
    icon: 'text-blue-600',
    Icon: Lightbulb,
  },
  tip: {
    container: 'border-green-500 bg-green-50 text-gray-800',
    icon: 'text-green-600',
    Icon: Lightbulb,
  },
} as const;

const { container, icon, Icon } = styles[variant];
---

<aside class:list={['mb-4 rounded-r-lg border-l-4 p-4', container, className]}>
  <div class="flex items-start gap-3">
    <Icon className={`mt-0.5 shrink-0 ${icon}`} size={24} aria-hidden="true" />
    <div class="min-w-0 flex-1">
      <slot />
    </div>
  </div>
</aside>
