---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="mb-16 scroll-mt-24 lg:scroll-mt-6">
  <h2 class="mb-6 inline-block border-b-4 border-brand-primary pb-2 text-3xl font-bold text-brand-dark">
    {title}
  </h2>
  <slot />
</section>
