---
import Layout from '../layouts/Layout.astro';
import { translations, type SupportedLanguage } from '../data/translations';
import { checklistIds } from '../data/checklistIds';
import { technicalReviewDate, technicalSources } from '../data/sources';
import Checklist from '../components/Checklist';
import Callout from '../components/Callout.astro';
import GuideFigure from '../components/GuideFigure.astro';
import SidebarNavigation from '../components/SidebarNavigation.astro';
import GuideSection from '../components/GuideSection.astro';
import RichText from '../components/RichText.astro';
import StepList from '../components/StepList.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
    { params: { lang: 'de' } },
  ];
}

const lang = Astro.params.lang as SupportedLanguage;
const t = translations[lang];

---

<Layout title={t.siteName} description={t.tagline} lang={lang} skipLink={t.ui.skipLink}>
  <div class="min-h-screen flex flex-col lg:flex-row">
    <SidebarNavigation
      currentLang={lang}
      tagline={t.tagline}
      navigation={t.navigation}
      navigationLabel={t.ui.navigationLabel}
      languageLabel={t.ui.languageLabel}
      siteName={t.siteName}
    />

    <!-- Main Content -->
    <main id="content" tabindex="-1" class="min-w-0 flex-1 p-5 sm:p-8 lg:p-12">
      <div class="mx-auto max-w-5xl">
      <header class="mb-10 grid items-center gap-8 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200 sm:p-8 xl:grid-cols-2">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-brand-primary">PC · IT documentation · EN / ES / DE</p>
          <h1 class="mb-4 text-3xl font-bold leading-tight text-brand-dark sm:text-4xl">{t.siteName}</h1>
          <p class="mb-6 text-lg text-gray-700">{t.tagline}</p>
          <div class="flex flex-wrap gap-3">
            <a href="#prep" class="inline-flex min-h-11 items-center rounded-lg bg-brand-primary px-5 font-semibold text-white hover:bg-green-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary">{t.ui.openGuide}</a>
            <a href="https://github.com/sergioiglesiasleite/pc-assembly-standard" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center rounded-lg border border-gray-300 px-5 font-semibold text-brand-dark hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary">GitHub ↗</a>
          </div>
        </div>
        <img src="/images/assembly-hero.webp" alt={t.ui.heroAlt} width="1200" height="800" fetchpriority="high" class="aspect-[3/2] w-full rounded-xl object-cover" />
      </header>

      <section aria-labelledby="about-title" class="mb-12 rounded-2xl border border-gray-200 bg-white p-6 sm:p-8">
        <h2 id="about-title" class="mb-3 text-2xl font-bold text-brand-dark">{t.ui.aboutTitle}</h2>
        <p class="max-w-3xl text-gray-700">{t.ui.aboutBody}</p>
        <p class="mt-4 text-sm text-gray-600">{t.ui.independent}</p>
        <div class="mt-5 border-t border-gray-200 pt-4">
          <h3 class="mb-2 text-sm font-semibold text-brand-dark">{t.ui.technologiesTitle}</h3>
          <p class="text-sm text-gray-700">Astro · React · TypeScript · Tailwind CSS</p>
        </div>
      </section>

      <Callout variant="info" className="mb-12">
        <p>{t.ui.sourcesIntro}</p>
      </Callout>

      <!-- Section 1: Prep & Safety -->
      <GuideSection id="prep" title={t.sections.prep.title}>
        <div class="section-content">
          <div>
            <h3 class="text-2xl font-semibold text-brand-dark mb-3">{t.sections.prep.tools.title}</h3>
            <StepList items={t.sections.prep.tools.items} />
          </div>

          <div>
            <h3 class="text-2xl font-semibold text-brand-dark mb-3">{t.sections.prep.safety.title}</h3>
            <StepList items={t.sections.prep.safety.items} />
          </div>

          <Checklist client:load items={t.sections.prep.checklist} ids={checklistIds.prep} sectionId="prep" labels={t.ui} />
        </div>
      </GuideSection>

      <!-- Section 2: Hardware Assembly -->
      <GuideSection id="hardware" title={t.sections.hardware.title}>
        <div class="section-content">
          <!-- Beginner-Friendly Component Explanations -->
          {t.sections.hardware.beginner && (
            <Callout variant="tip" className="mb-8 p-6">
              <h3 class="mb-4 text-xl font-bold text-green-900">{t.sections.hardware.beginner.title}</h3>
              <ul class="space-y-3 text-gray-700">
                {t.sections.hardware.beginner.items.map((item: string) => (
                  <li class="leading-relaxed"><RichText text={item} /></li>
                ))}
              </ul>
            </Callout>
          )}

          <!-- CPU Installation -->
          <div>
            <h3 class="text-2xl font-semibold text-brand-dark mb-3">{t.sections.hardware.cpu.title}</h3>
            
            <Callout variant="warning">
              <p class="font-semibold">{t.sections.hardware.cpu.warning}</p>
            </Callout>

            <StepList items={t.sections.hardware.cpu.steps} ordered className="mt-4" />

            {t.sections.hardware.cpu.image && (
              <GuideFigure image={t.sections.hardware.cpu.image} />
            )}
          </div>

          <!-- RAM Installation -->
          <div>
            <h3 class="text-2xl font-semibold text-brand-dark mb-3">{t.sections.hardware.ram.title}</h3>
            
            {t.sections.hardware.ram.explanation && (
              <Callout>
                <p><RichText text={t.sections.hardware.ram.explanation} /></p>
              </Callout>
            )}

            <StepList items={t.sections.hardware.ram.steps} ordered />

            {t.sections.hardware.ram.image && (
              <GuideFigure image={t.sections.hardware.ram.image} />
            )}
          </div>

          <!-- Motherboard Installation -->
          <div>
            <h3 class="text-2xl font-semibold text-brand-dark mb-3">{t.sections.hardware.case.title}</h3>
            <StepList items={t.sections.hardware.case.steps} ordered />

            {t.sections.hardware.case.image && (
              <GuideFigure image={t.sections.hardware.case.image} />
            )}
          </div>

          <Checklist client:load items={t.sections.hardware.checklist} ids={checklistIds.hardware} sectionId="hardware" labels={t.ui} />
        </div>
      </GuideSection>

      <!-- Section 3: Cabling -->
      <GuideSection id="cabling" title={t.sections.cabling.title}>
        <div class="section-content">
          <div>
            <h3 class="text-2xl font-semibold text-brand-dark mb-3">{t.sections.cabling.frontPanel.title}</h3>
            
            <Callout variant="warning">
              <p class="font-semibold">{t.sections.cabling.frontPanel.warning}</p>
            </Callout>

            <StepList items={t.sections.cabling.frontPanel.connectors} className="mt-4" />

            {t.sections.cabling.frontPanel.image && (
              <GuideFigure image={t.sections.cabling.frontPanel.image} />
            )}
          </div>

          <div>
            <h3 class="text-2xl font-semibold text-brand-dark mb-3">{t.sections.cabling.power.title}</h3>
            <StepList items={t.sections.cabling.power.cables} />
            {t.sections.cabling.power.image && (
              <GuideFigure image={t.sections.cabling.power.image} maxWidth="lg" />
            )}
          </div>

          <!-- Fans Section -->
          {t.sections.cabling.fans && (
            <div>
              <h3 class="text-2xl font-semibold text-brand-dark mb-3">{t.sections.cabling.fans.title}</h3>
              <Callout>
                <StepList items={t.sections.cabling.fans.headers} className="mb-3" />
                <p class="font-semibold text-brand-dark"><RichText text={t.sections.cabling.fans.pwm} /></p>
              </Callout>
              {t.sections.cabling.fans.image && (
                <GuideFigure image={t.sections.cabling.fans.image} maxWidth="md" surface="white" />
              )}
            </div>
          )}

          <!-- RGB Section -->
          {t.sections.cabling.rgb && (
            <div>
               <h3 class="text-2xl font-semibold text-brand-dark mb-3">{t.sections.cabling.rgb.title}</h3>
               <Callout variant="warning">
                 <p class="font-bold text-red-700 text-lg mb-2">{t.sections.cabling.rgb.warning}</p>
                  <StepList items={t.sections.cabling.rgb.types} className="text-gray-800" />
               </Callout>
               {t.sections.cabling.rgb.image && (
                 <GuideFigure image={t.sections.cabling.rgb.image} maxWidth="lg" surface="white" />
               )}
            </div>
          )}

          <div>
            <h3 class="text-2xl font-semibold text-brand-dark mb-3">{t.sections.cabling.management.title}</h3>
            <Callout variant="tip">
              <StepList items={t.sections.cabling.management.tips} />
            </Callout>
            
            {t.sections.cabling.management.image && (
              <GuideFigure image={t.sections.cabling.management.image} />
            )}
          </div>

          <Checklist client:load items={t.sections.cabling.checklist} ids={checklistIds.cabling} sectionId="cabling" labels={t.ui} />
        </div>
      </GuideSection>

      <!-- Section 4: First Boot & Troubleshooting -->
      <GuideSection id="boot" title={t.sections.boot.title}>
        <div class="section-content">
          <div>
            <h3 class="text-2xl font-semibold text-brand-dark mb-3">{t.sections.boot.firstBoot.title}</h3>
              <StepList items={t.sections.boot.firstBoot.steps} ordered />
          </div>

          <div>
            <h3 class="text-2xl font-semibold text-brand-dark mb-4">{t.sections.boot.troubleshooting.title}</h3>
            
            <div class="bg-gray-100 rounded-lg p-5 mb-4">
              <h4 class="font-semibold text-lg text-brand-dark mb-2">{t.sections.boot.troubleshooting.noVideo.title}</h4>
              <StepList items={t.sections.boot.troubleshooting.noVideo.solutions} />
            </div>

            <!-- Clear CMOS Guide -->
            {t.sections.boot.troubleshooting.cmos && (
              <div class="bg-blue-50 border-l-4 border-blue-500 p-4 my-6 rounded-r-lg shadow-sm">
                <div class="flex items-start gap-3">
                  <div class="flex-grow">
                    <h4 class="font-bold text-lg text-brand-dark mb-2">{t.sections.boot.troubleshooting.cmos.title}</h4>
                    <StepList items={t.sections.boot.troubleshooting.cmos.steps} ordered className="mb-4" />
                    {t.sections.boot.troubleshooting.cmos.image && (
                      <GuideFigure
                        image={t.sections.boot.troubleshooting.cmos.image}
                        maxWidth="lg"
                        surface="plain"
                      />
                    )}
                  </div>
                </div>
              </div>
            )}
            
            <div class="bg-gray-100 rounded-lg p-5">
              <h4 class="font-semibold text-lg text-brand-dark mb-2">{t.sections.boot.troubleshooting.noPost.title}</h4>
              <StepList items={t.sections.boot.troubleshooting.noPost.solutions} />
            </div>
          </div>

          <div>
            <h3 class="text-2xl font-semibold text-brand-dark mb-3">{t.sections.boot.bios.title}</h3>
            
            {t.sections.boot.bios.explanation && (
               <p class="text-gray-700 mb-4 italic"><RichText text={t.sections.boot.bios.explanation} /></p>
            )}

            <StepList items={t.sections.boot.bios.steps} ordered className="mb-8" />

            <div class="space-y-8">
              <!-- XMP/EXPO -->
              {t.sections.boot.bios.xmpExpo && (
                <div class="bg-gray-50 p-6 rounded-lg border border-gray-200">
                  <h4 class="text-xl font-bold text-brand-dark mb-2">{t.sections.boot.bios.xmpExpo.title}</h4>
                  <p class="text-gray-700 mb-4"><RichText text={t.sections.boot.bios.xmpExpo.description} /></p>
                  {t.sections.boot.bios.xmpExpo.image && (
                    <GuideFigure image={t.sections.boot.bios.xmpExpo.image} maxWidth="lg" surface="plain" />
                  )}
                </div>
              )}

              <!-- UEFI vs Legacy -->
              {t.sections.boot.bios.uefiLegacy && (
                <div class="bg-gray-50 p-6 rounded-lg border border-gray-200">
                  <h4 class="text-xl font-bold text-brand-dark mb-2">{t.sections.boot.bios.uefiLegacy.title}</h4>
                  <p class="text-gray-700 mb-4"><RichText text={t.sections.boot.bios.uefiLegacy.description} /></p>
                  {t.sections.boot.bios.uefiLegacy.image && (
                    <GuideFigure image={t.sections.boot.bios.uefiLegacy.image} maxWidth="lg" surface="plain" />
                  )}
                </div>
              )}
              
               <!-- ERP -->
               {t.sections.boot.bios.erp && (
                <div class="bg-gray-50 p-6 rounded-lg border border-gray-200">
                  <h4 class="text-xl font-bold text-brand-dark mb-2">{t.sections.boot.bios.erp.title}</h4>
                  <p class="text-gray-700"><RichText text={t.sections.boot.bios.erp.description} /></p>
                </div>
              )}
            </div>
          </div>

          <Checklist client:load items={t.sections.boot.checklist} ids={checklistIds.boot} sectionId="boot" labels={t.ui} />
        </div>
      </GuideSection>

      <!-- Section 5: OS & Deployment -->
      <GuideSection id="os" title={t.sections.os.title}>
        <div class="section-content">
          <!-- USB Creation -->
          <div class="mb-8">
             <h3 class="text-2xl font-semibold text-brand-dark mb-3">{t.sections.os.usbCreation.title}</h3>
             <div class="space-y-4">
                 <p class="text-gray-700"><RichText text={t.sections.os.usbCreation.method1} /></p>
                 <p class="text-gray-700"><RichText text={t.sections.os.usbCreation.method2} /></p>
             </div>
          </div>

          <!-- Installation -->
          <div class="mb-8">
            <h3 class="text-2xl font-semibold text-brand-dark mb-3">{t.sections.os.installation.title}</h3>
            <StepList items={t.sections.os.installation.steps} ordered />
          </div>

          <!-- Drivers -->
          <div class="mb-8">
            <h3 class="text-2xl font-semibold text-brand-dark mb-3">{t.sections.os.drivers.title}</h3>
             <Callout>
                <p><RichText text={t.sections.os.drivers.explanation} /></p>
              </Callout>
            <StepList items={t.sections.os.drivers.order} ordered className="space-y-3" />
          </div>

          <!-- Post-Install -->
          <div class="mb-8">
            <h3 class="text-2xl font-semibold text-brand-dark mb-3">{t.sections.os.postInstall.title}</h3>
            <Callout variant="warning">
              <StepList items={t.sections.os.postInstall.critical} />
            </Callout>
          </div>

          <!-- Optimization -->
          <div class="mb-8">
              <h3 class="text-2xl font-semibold text-brand-dark mb-3">{t.sections.os.optimization.title}</h3>
              <StepList items={t.sections.os.optimization.steps} ordered />
          </div>
        </div>

        <Checklist client:load items={t.sections.os.checklist} ids={checklistIds.os} sectionId="os" labels={t.ui} />
      </GuideSection>

      <section aria-labelledby="sources-title" class="mt-14 rounded-2xl border border-gray-200 bg-white p-6 sm:p-8">
        <h2 id="sources-title" class="mb-3 text-2xl font-bold text-brand-dark">{t.ui.sourcesTitle}</h2>
        <p class="mb-4 text-gray-700">{t.ui.sourcesIntro}</p>
        <p class="mb-4 text-sm text-gray-600">{t.ui.reviewedLabel}: <time datetime={technicalReviewDate}>{technicalReviewDate}</time></p>
        <ul class="space-y-2">
          {technicalSources.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="noopener noreferrer" class="font-medium text-brand-primary underline underline-offset-4 hover:text-green-800 focus-visible:outline-2 focus-visible:outline-brand-primary">
                {source.title} ↗
              </a>
            </li>
          ))}
        </ul>
      </section>

      <footer class="mt-12 border-t border-gray-300 pt-6 text-sm text-gray-600">
        <p>© 2026 Sergio · {t.ui.footer}</p>
        <p class="mt-2">{t.ui.independent}</p>
      </footer>
      </div>
    </main>
  </div>
</Layout>
