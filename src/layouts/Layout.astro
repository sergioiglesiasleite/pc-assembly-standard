---
interface Props {
  title: string;
  description: string;
  lang: string;
  skipLink: string;
}

const { title, description, lang, skipLink } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL('/images/social-preview.jpg', Astro.site).href;
const locales = { en: 'en_US', es: 'es_ES', de: 'de_DE' } as const;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#007c54" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site).href} />
    <link rel="alternate" hreflang="es" href={new URL('/es/', Astro.site).href} />
    <link rel="alternate" hreflang="de" href={new URL('/de/', Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL('/en/', Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locales[lang as keyof typeof locales]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-gray-50">
    <a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:p-3 focus:text-brand-dark focus:shadow-lg">
      {skipLink}
    </a>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
